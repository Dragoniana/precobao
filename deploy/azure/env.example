# Copy to .env.azure on the Linux VM and chmod 600; replace every placeholder.
API_DOMAIN=precobao.app
EXPO_PUBLIC_API_URL=https://precobao.app/backend
WEB_DOWNLOADS_HOST_DIR=/opt/preco-bao/downloads
API_IMAGE=preco-bao-api:latest
BACKEND_CORS_ORIGINS='["https://precobao.app"]'
APP_DEBUG=false
CADDY_API_SUBNET=172.29.240.0/24
CADDY_API_IP=172.29.240.2
API_CONTAINER_IP=172.29.240.3
WEB_CONTAINER_IP=172.29.240.4

# The VM and Flexible Server must resolve/reach each other over the private VNet.
# Use the Azure server's canonical FQDN, URL-encode special characters in the
# password, and keep sslmode=verify-full plus the mounted CA bundle path.
DATABASE_URL='postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?sslmode=verify-full&sslrootcert=/run/secrets/azure-postgres-root-ca.pem'
AZURE_PG_ROOT_CERT_PATH=/etc/ssl/certs/ca-certificates.crt
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_VALUE_AT_LEAST_48_CHARACTERS

# Caddy's fixed address is the only trusted X-Forwarded-* peer in Uvicorn.
CADDY_API_SUBNET=172.29.240.0/24
CADDY_API_IP=172.29.240.2

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_CATALOG_PER_MINUTE=120
RATE_LIMIT_PASSWORD_RESET_REQUESTS_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_CONFIRMS_PER_HOUR=10
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Preço Bão
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_URL=https://precobao.app/reset-password
# Optional server-to-server collector authentication. Generate a unique 32+ byte
# secret directly on the VM at SCRAPER_INGEST_HMAC_SECRET_HOST_FILE; never put its
# contents in this file. The API reads SCRAPER_INGEST_HMAC_SECRET_FILE from a
# read-only bind mount; the legacy environment variable remains for staging.
SCRAPER_INGEST_HMAC_SECRET=
SCRAPER_INGEST_HMAC_SECRET_FILE=
SCRAPER_INGEST_HMAC_SECRET_HOST_FILE=/dev/null
SCRAPER_INGEST_ALLOWED_SOURCES=
SCRAPER_INGEST_MAX_BODY_BYTES=1000000
SCRAPER_INGEST_RATE_LIMIT_PER_HOUR=120

# Automatic maintenance keeps the existing Indiana refresh enabled by default.
# Keep Araújo and Pacheco disabled until access is explicitly homologated.
INDIANA_SCRAPER_ENABLED=true
INDIANA_REQUEST_DELAY_SECONDS=2
INDIANA_REFRESH_BATCH=250
INDIANA_REFRESH_DELAY_SECONDS=2
SCRAPER_INTERVAL_HOURS=24
SCRAPER_LOG_LEVEL=INFO
SCRAPER_IMAGE_MAX_BYTES=524288
SCRAPER_IMAGE_MAX_DIMENSION=1200
SCRAPER_IMAGE_INGEST_RATE_LIMIT_PER_HOUR=600
OFFER_REFRESH_ENABLED=true
OFFER_REFRESH_INTERVAL_MINUTES=30
OFFER_REFRESH_SOURCES=indiana
OFFER_IMAGE_REFRESH_SOURCES=indiana
OFFER_REFRESH_DAILY_SOURCES=
OFFER_REFRESH_INDIANA_BATCH=200
OFFER_REFRESH_ARAUJO_BATCH=20
OFFER_REFRESH_REQUEST_DELAY_SECONDS=1
OFFER_IMAGE_REFRESH_INDIANA_BATCH=150
OFFER_IMAGE_REFRESH_ARAUJO_BATCH=20
OFFER_IMAGE_REFRESH_PACHECO_BATCH=100
ARAUJO_SOURCE_MODE=DISABLED
ARAUJO_SCHEDULER_ENABLED=false
ARAUJO_INTERVAL_HOURS=24
ARAUJO_FAILURE_RETRY_MINUTES=60
ARAUJO_REQUEST_DELAY_SECONDS=1
ARAUJO_MAX_PAGES=200
# Source-only HTTP settings. Defaults keep HTTPX and TLS verification enabled.
ARAUJO_HTTP_CLIENT=httpx
ARAUJO_CURL_IMPERSONATE=chrome110
ARAUJO_TLS_VERIFY=true
ARAUJO_HTTP_TIMEOUT_SECONDS=30
ARAUJO_PUBLIC_CATALOG_AUTHORIZED=false
ARAUJO_ACCESS_CONFIRMED=false
ARAUJO_PARTNER_FEED_FILE=
ARAUJO_PARTNER_FEED_URL=
PACHECO_SOURCE_MODE=DISABLED
PACHECO_SCHEDULER_ENABLED=false
PACHECO_INTERVAL_HOURS=24
PACHECO_FAILURE_RETRY_MINUTES=60
PACHECO_REQUEST_DELAY_SECONDS=1
PACHECO_HTTP_CLIENT=httpx
PACHECO_CURL_IMPERSONATE=chrome110
PACHECO_TLS_VERIFY=true
PACHECO_HTTP_TIMEOUT_SECONDS=30
PACHECO_PUBLIC_API_AUTHORIZED=false
PACHECO_ACCESS_CONFIRMED=false
PACHECO_PARTNER_FEED_FILE=
PACHECO_PARTNER_FEED_URL=

# Optional local backup settings. Keep the GPG secret key off this VM.
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_FINGERPRINT=
BACKUP_DIR=/var/backups/preco-bao
POSTGRES_CLIENT_IMAGE=postgres:15.19-alpine

# Set these only for a controlled restore into a new, empty database.
RESTORE_DATABASE_URL='postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@RESTORE_SERVER.postgres.database.azure.com:5432/RESTORE_DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt'
RESTORE_CONFIRMATION=
RESTORE_OUTPUT_DIR=/var/backups/preco-bao/restore-staging
