# Copy to .env.azure on the Linux VM and chmod 600; replace every placeholder.
API_DOMAIN=api.example.invalid
EXPO_PUBLIC_API_URL=https://api.example.invalid
BACKEND_CORS_ORIGINS='["https://replace-with-your-static-web-app.azurestaticapps.net"]'
APP_DEBUG=false

# The VM and Flexible Server must resolve/reach each other over the private VNet.
# Use the Azure server's canonical FQDN, URL-encode special characters in the
# password, and keep sslmode=verify-full plus the mounted CA bundle path.
DATABASE_URL='postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?sslmode=verify-full&sslrootcert=/run/secrets/azure-postgres-root-ca.pem'
AZURE_PG_ROOT_CERT_PATH=/etc/ssl/certs/ca-certificates.crt
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_VALUE_AT_LEAST_48_CHARACTERS

# Caddy's fixed address is the only trusted X-Forwarded-* peer in Uvicorn.
CADDY_API_SUBNET=172.29.240.0/24
CADDY_API_IP=172.29.240.2

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_CATALOG_PER_MINUTE=120

# Automatic catalog maintenance workers. Keep enabled to refresh existing offers
# and discover/update Pacheco products on the production database.
OFFER_REFRESH_ENABLED=true
OFFER_REFRESH_INTERVAL_MINUTES=30
OFFER_REFRESH_INDIANA_BATCH=200
OFFER_REFRESH_ARAUJO_BATCH=20
OFFER_REFRESH_REQUEST_DELAY_SECONDS=1
OFFER_IMAGE_REFRESH_INDIANA_BATCH=150
OFFER_IMAGE_REFRESH_ARAUJO_BATCH=20
OFFER_IMAGE_REFRESH_PACHECO_BATCH=100
PACHECO_SCHEDULER_ENABLED=true
PACHECO_INTERVAL_HOURS=24
PACHECO_FAILURE_RETRY_MINUTES=60
PACHECO_REQUEST_DELAY_SECONDS=1

# Optional local backup settings. Keep the GPG secret key off this VM.
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_FINGERPRINT=
BACKUP_DIR=/var/backups/preco-bao

# Set these only for a controlled restore into a new, empty database.
RESTORE_DATABASE_URL='postgresql+psycopg2://USER:URL_ENCODED_PASSWORD@RESTORE_SERVER.postgres.database.azure.com:5432/RESTORE_DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt'
RESTORE_CONFIRMATION=
RESTORE_OUTPUT_DIR=/var/backups/preco-bao/restore-staging
